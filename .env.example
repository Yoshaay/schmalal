# Schmalal — Environment-Variablen
# Kopiere diese Datei nach `.env` und fülle die Werte aus. `.env` ist
# bereits in .gitignore; commits sicher.

# ─── Pflicht ───────────────────────────────────────────────────────────────

# LALAL.AI v1 License-Key (https://www.lalal.ai/billing/api/)
LALAL_LICENSE=

# ─── Auth-Gates: mindestens einen für Public-Deploy setzen ────────────────

# Rhythmus-Gate: Komma-separierte Halbton-Intervalle. Default = Bayern 3
# Sound-Logo (D-C-G, also -2 dann +7). Wir prüfen nur die Diffs, daher
# funktionieren transponierte Versionen (D#-C#-G#, E-D-A, …) ebenfalls.
# Leer lassen, um das Rhythm-Gate zu deaktivieren.
SCHMALAL_RHYTHM_INTERVALS=-2,7

# 4-stelliger PIN als Fallback. Wenn beide gesetzt sind, zeigt das Frontend
# das Klavier mit einem „Code statt Klavier"-Link. Muss exakt 4 Ziffern sein,
# alles andere wird beim Start verworfen.
SCHMALAL_PIN=

# Flask-Session-Schlüssel. Wenn nicht gesetzt, wird bei jedem Restart einer
# generiert — das invalidiert alle Sessions. In Production unbedingt setzen.
# Generieren mit:  python3 -c 'import secrets; print(secrets.token_hex(32))'
SCHMALAL_SECRET_KEY=

# ─── Caps (optional, sinnvolle Defaults) ──────────────────────────────────

# Upload-Größenlimit in Bytes (Default 100 MB).
# SCHMALAL_MAX_BYTES=104857600

# Audio-Längen-Limit in Sekunden (Default 600 = 10 min).
# SCHMALAL_MAX_DURATION_SEC=600

# ─── Per-IP-Rate-Limits (optional) ────────────────────────────────────────

# Format: "<n> per <window>", oder kombiniert mit ";" — siehe Flask-Limiter.
# SCHMALAL_RL_UPLOAD=20 per hour
# SCHMALAL_RL_SPLIT=10 per hour
# SCHMALAL_RL_CHECK=240 per minute
# SCHMALAL_RL_DOWNLOAD=120 per hour
# SCHMALAL_RL_AUTH=10 per minute

# ─── Cookies (optional) ───────────────────────────────────────────────────

# Auf "1" setzen wenn nur HTTPS — markiert das Session-Cookie als Secure.
# SCHMALAL_COOKIE_SECURE=1

# ─── Schmalsoft Hub / Health (optional) ───────────────────────────────────

# Version in GET /health. Default: "version" aus package.json.
# APP_VERSION=0.2.0

# Nach einem LALAL-Verbindungs- oder 5xx-Fehler meldet /health den Check
# "lalal" so viele Sekunden lang als "degraded" (Default 300).
# SCHMALAL_UPSTREAM_ERROR_WINDOW_SEC=300
